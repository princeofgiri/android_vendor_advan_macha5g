on post-fs-data
    mkdir /data/gf_data 0770 system system
    restorecon /data/gf_data
    mkdir /data/vendor/goodix 0770 system system
    restorecon /data/vendor/goodix
    mkdir /mnt/vendor/persist/goodix 0770 system system
    restorecon /mnt/vendor/persist/goodix
    chmod 0666 /dev/goodix_fp
    chown system system /dev/goodix_fp

service vendor.pri.fingerprint /vendor/bin/hw/vendor.pri.hardware.biometrics.fingerprint-service
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    user system
    group system input uhid
